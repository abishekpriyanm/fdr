# Local synthetic demo only. Copy to .env.local and replace both password placeholders.
# Use the same URL-safe password in POSTGRES_PASSWORD and DATABASE_URL.
DEMO_MODE=true
POSTGRES_USER=fdr_demo
POSTGRES_PASSWORD=replace-with-local-demo-password
POSTGRES_DB=fdr_demo
POSTGRES_PORT=54329
DATABASE_URL=postgresql://fdr_demo:replace-with-local-demo-password@127.0.0.1:54329/fdr_demo

# Reserved for Phase 1 authentication; unused by the Phase 0 runtime.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Reserved for Phase 2; keep outside public/. Ignored by version control.
PRIVATE_STORAGE_PATH=.data/private-documents
