{
  "name": "fdr-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:up": "docker compose --env-file .env.local up -d --wait postgres",
    "db:down": "docker compose --env-file .env.local down",
    "db:check": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/check-db.ts",
    "local": "npm run db:up && npm run db:check && npm run dev"
  },
  "dependencies": {
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3"
  }
}
